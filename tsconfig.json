{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "jsx": "preserve"
  },
  "include": [
    "src/**/*.ts",
    "src/vue-shim.d.ts",
    "src/client/background/virtual-backgrounds.d.ts"
  ]
}
