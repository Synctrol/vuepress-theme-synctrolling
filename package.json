{
  "name": "vuepress-theme-synctrolling",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-client-assets.mjs",
    "test:typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:build-smoke": "npm run build && node scripts/smoke-built-exports.mjs",
    "test": "npm run test:typecheck && vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vuepress": "^2.0.0-rc.24"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-container": "^4.0.0",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^17.6.3",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.0",
    "vuepress": "^2.0.0-rc.24"
  },
  "engines": {
    "node": "^20.9.0 || >=22.0.0"
  },
  "dependencies": {
    "markdown-it": "^15.0.0",
    "markdown-it-container": "^4.0.0",
    "yaml": "^2.9.0"
  }
}
